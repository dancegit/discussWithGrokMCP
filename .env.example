# Copy to .env.
# Backend: "auto" (API if XAI_API_KEY is set, else the grok CLI), "api" or "cli"
GROK_BACKEND=auto

# api backend: key from https://console.x.ai
XAI_API_KEY=your_api_key_here

# cli backend: uses your `grok login` session (OAuth). All optional.
# GROK_CLI_PATH=/path/to/grok   # default: found on PATH
# GROK_CLI_MODEL=grok-4.7       # default: the CLI's default model
# GROK_CLI_TIMEOUT=300          # seconds per request

# Model defaults (per-call `model` arguments override these)
GROK_MODEL=grok-code-fast
GROK_TEMPERATURE=0.7
GROK_MAX_TOKENS=4096

# Panels: extra directories of agent .md files (os.pathsep-separated), parallel calls per round
# GROK_AGENTS_DIR=~/my-grok-agents
# GROK_PANEL_CONCURRENCY=4

# Logging
MCP_LOG_LEVEL=INFO
MCP_LOG_FILE=enhanced_mcp.log

# Response cache
MCP_ENABLE_CACHING=true
MCP_CACHE_TTL=3600
MAX_CACHE_SIZE_MB=100
MCP_MAX_RESPONSE_TOKENS=40000

# Feature flags
MCP_ENABLE_STREAMING=false
ENABLE_SESSIONS=true
ENABLE_CONTEXT=true
ENABLE_RESOURCES=true
ENABLE_HEALTH_CHECK=true

# Session memory management
MAX_SESSION_SIZE_MB=50
MAX_ACTIVE_SESSIONS=100
MEMORY_CLEANUP_INTERVAL_HOURS=1
SESSION_INACTIVITY_TIMEOUT_HOURS=2
